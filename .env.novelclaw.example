# .env template for novelclaw
# Copy this file to apps/novelclaw/.env and configure your values

# API keys are optional for opening the UI. Add keys when you use a cloud provider.
DEEPSEEK_API_KEY=your-deepseek-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Database
APP_DATABASE_URL=sqlite:///./local_web_portal/data/app.db
APP_AUTH_DATABASE_URL=sqlite:///../auth-portal/local_web_portal/data/app.db

# Generation / providers
WEB_MODELLESS_MODE=0
WEB_DEFAULT_PROVIDER=deepseek

# Server
HOST=0.0.0.0
PORT=8012
WEB_UI_LANGUAGE=zh

# Security: use the same values across auth-portal, multiagent, and novelclaw
APP_SESSION_SECRET=change-this-shared-session-secret
APP_SESSION_COOKIE_NAME=novelclaw_session
APP_SHARED_PORTAL_PORT=8010
APP_AGENT_USER_EMAIL=agent@novelclaw.local
# Set this to enable token-authenticated /api/v1 endpoints for CLI agents.
# APP_AGENT_API_KEY=change-this-agent-api-key

# Storage
APP_RUNS_DIR=./local_web_portal/runs
