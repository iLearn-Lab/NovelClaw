# .env template for auth-portal
# Copy this file to apps/auth-portal/.env and configure your values

# Database
APP_DATABASE_URL=sqlite:///./local_web_portal/data/app.db

# Security: use the same values across auth-portal, multiagent, and novelclaw
APP_SESSION_SECRET=change-this-shared-session-secret
APP_SESSION_COOKIE_NAME=novelclaw_session

# Server
HOST=0.0.0.0
PORT=8010
WEB_UI_LANGUAGE=zh

# Docker/local entry routing. Full APP_*_URL values override the dynamic host+port defaults.
APP_MULTIAGENT_PORT=8011
APP_CLAW_PORT=8012
# APP_MULTIAGENT_URL=http://localhost:8011/dashboard
# APP_CLAW_URL=http://localhost:8012/dashboard
